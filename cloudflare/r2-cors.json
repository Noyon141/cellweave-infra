[
  {
    "AllowedOrigins": [
      "https://app.cellweave.com",
      "https://staging.cellweave.com",
      "https://dev.cellweave.internal",
      "https://*.vercel.app",
      "http://localhost:3000"
    ],
    "AllowedMethods": [
      "GET",
      "PUT",
      "POST",
      "HEAD"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Content-MD5",
      "x-amz-content-sha256",
      "x-amz-date",
      "authorization",
      "x-amz-security-token",
      "x-amz-user-agent"
    ],
    "ExposeHeaders": [
      "ETag",
      "x-amz-request-id",
      "x-amz-id-2"
    ],
    "MaxAgeSeconds": 3600
  }
]
