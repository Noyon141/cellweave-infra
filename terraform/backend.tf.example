# Example Remote State Backend Configuration (OpenTofu / Terraform)
# Rename to backend.tf and supply backend parameters via environment or CLI flags (-backend-config)
# Do not commit real credentials or state bucket secrets to git.

terraform {
  backend "s3" {
    bucket                      = "cellweave-terraform-state"
    key                         = "infra/${var.environment}/terraform.tfstate"
    region                      = "auto"
    endpoint                    = "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com"
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
  }
}
