# Production Environment Configuration
# Strictly isolated; production credentials never share with non-production environments

CELLWEAVE_ENV=production
NODE_ENV=production

# Web / Next.js
NEXT_PUBLIC_APP_URL=https://app.cellweave.com
BETTER_AUTH_SECRET=__REPLACE_WITH_PRODUCTION_BETTER_AUTH_SECRET__
BETTER_AUTH_URL=https://app.cellweave.com

# Google OAuth
GOOGLE_CLIENT_ID=__REPLACE_WITH_PROD_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__REPLACE_WITH_PROD_GOOGLE_CLIENT_SECRET__

# Database (Neon Production Primary Database)
DATABASE_URL=postgres://cellweave_app_user:__PASSWORD__@ep-prod-primary.us-east-2.aws.neon.tech/cellweave?sslmode=require
DATABASE_MIGRATION_URL=postgres://cellweave_migrator:__PASSWORD__@ep-prod-primary.us-east-2.aws.neon.tech/cellweave?sslmode=require

# Cloudflare R2 (Dedicated Production Scientific Storage Bucket)
R2_ACCOUNT_ID=__CLOUDFLARE_PROD_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__CLOUDFLARE_PROD_R2_ACCESS_KEY__
R2_SECRET_ACCESS_KEY=__CLOUDFLARE_PROD_R2_SECRET_KEY__
R2_BUCKET_NAME=cellweave-artifacts-prod
R2_ENDPOINT=https://__CLOUDFLARE_PROD_ACCOUNT_ID__.r2.cloudflarestorage.com

# Orchestration (Temporal Cloud Production Namespace)
TEMPORAL_ADDRESS=cellweave-prod.tmprl.cloud:7233
TEMPORAL_NAMESPACE=cellweave-prod
TEMPORAL_TASK_QUEUE=cellweave-analysis-queue-prod
TEMPORAL_TLS_CERT_PATH=/etc/temporal/certs/client.pem
TEMPORAL_TLS_KEY_PATH=/etc/temporal/certs/client.key

# Scientific Compute (Modal Production Environment)
COMPUTE_PROVIDER=MODAL
MODAL_TOKEN_ID=__MODAL_PROD_TOKEN_ID__
MODAL_TOKEN_SECRET=__MODAL_PROD_TOKEN_SECRET__
MODAL_ENVIRONMENT=prod

# Billing (Polar Production Mode)
BILLING_PROVIDER=POLAR
POLAR_ENVIRONMENT=production
POLAR_ACCESS_TOKEN=polar_live_prod_token
POLAR_WEBHOOK_SECRET=polar_whsec_prod_live_secret

# Email Gateway (Resend Production API Key)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=re_prod_secret_live_key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-prod.cellweave.internal:4318
SENTRY_DSN=https://prod_sentry_dsn@o0.ingest.sentry.io/0
