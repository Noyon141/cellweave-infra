# Vercel Preview Environment Variable Template
# Dynamically mapped by Vercel GitHub Integration for Pull Requests

CELLWEAVE_ENV=preview
NODE_ENV=production

# Web / Next.js
NEXT_PUBLIC_APP_URL=https://cellweave-git-pr-$VERCEL_GIT_PULL_REQUEST_ID.vercel.app
BETTER_AUTH_SECRET=__REPLACE_WITH_PREVIEW_BETTER_AUTH_SECRET__
BETTER_AUTH_URL=https://cellweave-git-pr-$VERCEL_GIT_PULL_REQUEST_ID.vercel.app

# Google OAuth (Preview Client)
GOOGLE_CLIENT_ID=__PREVIEW_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__PREVIEW_GOOGLE_CLIENT_SECRET__

# Database (Ephemeral Neon branch provisioned from sanitized staging baseline)
DATABASE_URL=postgres://cellweave_preview_user:__PASSWORD__@ep-preview-$VERCEL_GIT_PULL_REQUEST_ID.us-east-2.aws.neon.tech/cellweave?sslmode=require
DATABASE_MIGRATION_URL=postgres://cellweave_preview_admin:__PASSWORD__@ep-preview-$VERCEL_GIT_PULL_REQUEST_ID.us-east-2.aws.neon.tech/cellweave?sslmode=require

# Cloudflare R2 (Dedicated Preview Bucket with ephemeral retention purge)
R2_ACCOUNT_ID=__CLOUDFLARE_DEV_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__CLOUDFLARE_DEV_R2_ACCESS_KEY__
R2_SECRET_ACCESS_KEY=__CLOUDFLARE_DEV_R2_SECRET_KEY__
R2_BUCKET_NAME=cellweave-artifacts-preview
R2_ENDPOINT=https://__CLOUDFLARE_DEV_ACCOUNT_ID__.r2.cloudflarestorage.com

# Orchestration (Temporal Preview Namespace)
TEMPORAL_ADDRESS=cellweave-preview.tmprl.cloud:7233
TEMPORAL_NAMESPACE=cellweave-preview
TEMPORAL_TASK_QUEUE=cellweave-analysis-queue-preview

# Scientific Compute (Modal Preview Environment)
COMPUTE_PROVIDER=MODAL
MODAL_TOKEN_ID=__MODAL_DEV_TOKEN_ID__
MODAL_TOKEN_SECRET=__MODAL_DEV_TOKEN_SECRET__
MODAL_ENVIRONMENT=preview

# Billing (Polar Sandbox Mode)
BILLING_PROVIDER=POLAR
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=polar_sand_preview_token
POLAR_WEBHOOK_SECRET=polar_whsec_preview_secret

# Email Gateway (Mock / Console Output for Previews)
EMAIL_PROVIDER=CONSOLE
RESEND_API_KEY=re_preview_mock_key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=https://preview_sentry_dsn@o0.ingest.sentry.io/0
