# Development Environment Configuration
# Deployed / CI integration test environment

# ==============================================================================
# PHASE 0 — MANDATORY FOUNDATION CONFIGURATION
# Required for deploying and verifying Phase 0 placeholder services
# ==============================================================================

CELLWEAVE_ENV=development
NODE_ENV=production

# Web / Next.js Placeholder
NEXT_PUBLIC_APP_URL=https://dev.cellweave.internal

# Database (Neon Development Branch)
DATABASE_URL=postgres://cellweave_dev_user:__PASSWORD__@ep-dev-123456.us-east-2.aws.neon.tech/cellweave?sslmode=require
DATABASE_MIGRATION_URL=postgres://cellweave_dev_admin:__PASSWORD__@ep-dev-123456.us-east-2.aws.neon.tech/cellweave?sslmode=require

# Cloudflare R2 (Dedicated Development Bucket)
R2_ACCOUNT_ID=__CLOUDFLARE_DEV_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__CLOUDFLARE_DEV_R2_ACCESS_KEY__
R2_SECRET_ACCESS_KEY=__CLOUDFLARE_DEV_R2_SECRET_KEY__
R2_BUCKET_NAME=cellweave-artifacts-dev
R2_ENDPOINT=https://__CLOUDFLARE_DEV_ACCOUNT_ID__.r2.cloudflarestorage.com

# Orchestration (Temporal Cloud Development Namespace)
TEMPORAL_ADDRESS=cellweave-dev.tmprl.cloud:7233
TEMPORAL_NAMESPACE=cellweave-dev
TEMPORAL_TASK_QUEUE=cellweave-analysis-queue-dev
TEMPORAL_API_KEY=__REPLACE_WITH_DEV_TEMPORAL_API_KEY__

# Scientific Compute (Modal Development Environment)
COMPUTE_PROVIDER=MODAL
MODAL_TOKEN_ID=__MODAL_DEV_TOKEN_ID__
MODAL_TOKEN_SECRET=__MODAL_DEV_TOKEN_SECRET__
MODAL_ENVIRONMENT=dev

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-dev.cellweave.internal:4318
SENTRY_DSN=https://dev_sentry_dsn@o0.ingest.sentry.io/0

# ==============================================================================
# PHASE 1+ / LATER-PHASE FEATURE CONFIGURATION
# (Documented for environment completeness; not blocking Phase 0 placeholder deployment)
# ==============================================================================

# Identity & Auth (Phase 1)
BETTER_AUTH_SECRET=__OPTIONAL_IN_PHASE_0__
BETTER_AUTH_URL=https://dev.cellweave.internal
GOOGLE_CLIENT_ID=__OPTIONAL_IN_PHASE_0__
GOOGLE_CLIENT_SECRET=__OPTIONAL_IN_PHASE_0__

# Billing Gateway (Phase 11)
BILLING_PROVIDER=POLAR
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=__OPTIONAL_IN_PHASE_0__
POLAR_WEBHOOK_SECRET=__OPTIONAL_IN_PHASE_0__

# Email Notifications (Phase 10/12)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=__OPTIONAL_IN_PHASE_0__
