# Local Development Environment Configuration
# Used for running CellWeave locally on developer workstations

# System Environment
CELLWEAVE_ENV=local
NODE_ENV=development

# Web / Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=local_insecure_betterauth_secret_minimum_32_chars_123456
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Optional in local development; local email/password authentication is default)
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Database (Local Postgres or Dev Neon Branch)
DATABASE_URL=postgres://cellweave:cellweave_local_password@localhost:5432/cellweave_dev
DATABASE_MIGRATION_URL=postgres://cellweave:cellweave_local_password@localhost:5432/cellweave_dev

# Storage (Local MinIO S3-compatible service)
R2_ACCOUNT_ID=local-minio
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=cellweave-artifacts-local
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_DOMAIN=http://localhost:9000/cellweave-artifacts-local

# Orchestration (Local Temporal Dev Server)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cellweave-analysis-queue

# Scientific Compute (Local mock or local Python Docker container)
COMPUTE_PROVIDER=LOCAL
MODAL_ENVIRONMENT=dev

# Billing (Mock adapter in local environment)
BILLING_PROVIDER=MOCK
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=polar_sandbox_mock_token
POLAR_WEBHOOK_SECRET=polar_mock_webhook_secret

# Email Gateway (Local console logger)
EMAIL_PROVIDER=CONSOLE
RESEND_API_KEY=re_local_mock_key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
