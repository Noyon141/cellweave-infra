# Staging Environment Configuration
# Must preserve the exact architectural topology of production

CELLWEAVE_ENV=staging
NODE_ENV=production

# Web / Next.js
NEXT_PUBLIC_APP_URL=https://staging.cellweave.com
BETTER_AUTH_SECRET=__REPLACE_WITH_STAGING_BETTER_AUTH_SECRET__
BETTER_AUTH_URL=https://staging.cellweave.com

# Google OAuth
GOOGLE_CLIENT_ID=__REPLACE_WITH_STAGING_GOOGLE_CLIENT_ID__
GOOGLE_CLIENT_SECRET=__REPLACE_WITH_STAGING_GOOGLE_CLIENT_SECRET__

# Database (Neon Staging Branch - Sanitized baseline)
DATABASE_URL=postgres://cellweave_staging_user:__PASSWORD__@ep-staging-654321.us-east-2.aws.neon.tech/cellweave?sslmode=require
DATABASE_MIGRATION_URL=postgres://cellweave_staging_admin:__PASSWORD__@ep-staging-654321.us-east-2.aws.neon.tech/cellweave?sslmode=require

# Cloudflare R2 (Dedicated Staging Bucket)
R2_ACCOUNT_ID=__CLOUDFLARE_STAGING_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__CLOUDFLARE_STAGING_R2_ACCESS_KEY__
R2_SECRET_ACCESS_KEY=__CLOUDFLARE_STAGING_R2_SECRET_KEY__
R2_BUCKET_NAME=cellweave-artifacts-staging
R2_ENDPOINT=https://__CLOUDFLARE_STAGING_ACCOUNT_ID__.r2.cloudflarestorage.com

# Orchestration (Temporal Cloud Staging Namespace)
TEMPORAL_ADDRESS=cellweave-staging.tmprl.cloud:7233
TEMPORAL_NAMESPACE=cellweave-staging
TEMPORAL_TASK_QUEUE=cellweave-analysis-queue-staging
TEMPORAL_TLS_CERT_PATH=/etc/temporal/certs/client.pem
TEMPORAL_TLS_KEY_PATH=/etc/temporal/certs/client.key

# Scientific Compute (Modal Staging Environment)
COMPUTE_PROVIDER=MODAL
MODAL_TOKEN_ID=__MODAL_STAGING_TOKEN_ID__
MODAL_TOKEN_SECRET=__MODAL_STAGING_TOKEN_SECRET__
MODAL_ENVIRONMENT=staging

# Billing (Polar Sandbox Mode)
BILLING_PROVIDER=POLAR
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=polar_sand_staging_token
POLAR_WEBHOOK_SECRET=polar_whsec_staging_secret

# Email Gateway (Resend Staging API Key)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=re_staging_secret_key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector-staging.cellweave.internal:4318
SENTRY_DSN=https://staging_sentry_dsn@o0.ingest.sentry.io/0
